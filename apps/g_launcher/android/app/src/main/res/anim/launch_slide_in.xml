<?xml version="1.0" encoding="utf-8"?>
<!-- PHASE 6, launch style "slide": the opening app rises a short way as it
     fades in. Short and decelerating, so it reads as a window mapping rather
     than a page sliding across. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <translate
        android:fromYDelta="8%p"
        android:toYDelta="0" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
